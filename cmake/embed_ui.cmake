# Generates a C++ source file that embeds every file of a directory as a byte array.
# Usage: cmake -DUI_DIR=<dir> -DOUT=<file.cpp> -P embed_ui.cmake
# (Pure CMake so the build needs no Python or other tools.)
if(NOT UI_DIR OR NOT OUT)
  message(FATAL_ERROR "embed_ui.cmake: pass -DUI_DIR=... -DOUT=...")
endif()

file(GLOB ASSET_FILES RELATIVE "${UI_DIR}" "${UI_DIR}/*")
list(SORT ASSET_FILES)
if(NOT ASSET_FILES)
  message(FATAL_ERROR "embed_ui.cmake: no files found in ${UI_DIR}")
endif()

set(MIME_html "text/html; charset=utf-8")
set(MIME_css  "text/css; charset=utf-8")
set(MIME_js   "text/javascript; charset=utf-8")
set(MIME_svg  "image/svg+xml")
set(MIME_png  "image/png")
set(MIME_ico  "image/x-icon")
set(MIME_json "application/json; charset=utf-8")

set(CONTENT "// Generated by cmake/embed_ui.cmake - do not edit.\n#include \"ui_assets.hpp\"\n\nnamespace fraudnet {\nnamespace {\n")
set(TABLE "")
set(INDEX 0)
foreach(F IN LISTS ASSET_FILES)
  get_filename_component(EXT "${F}" LAST_EXT)
  string(SUBSTRING "${EXT}" 1 -1 EXT)
  if(DEFINED MIME_${EXT})
    set(MIME "${MIME_${EXT}}")
  else()
    set(MIME "application/octet-stream")
  endif()
  file(READ "${UI_DIR}/${F}" HEX HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
  string(APPEND CONTENT "const unsigned char kAsset${INDEX}[] = {${BYTES}0};\n")
  string(LENGTH "${HEX}" HEXLEN)
  math(EXPR SIZE "${HEXLEN} / 2")
  string(APPEND TABLE "    {\"/${F}\", \"${MIME}\", kAsset${INDEX}, ${SIZE}},\n")
  math(EXPR INDEX "${INDEX} + 1")
endforeach()
string(APPEND CONTENT "const EmbeddedAsset kAssets[] = {\n${TABLE}};\n}  // namespace\n\n")
string(APPEND CONTENT "const EmbeddedAsset* embeddedUiAssets(std::size_t& count) {\n  count = sizeof kAssets / sizeof kAssets[0];\n  return kAssets;\n}\n\n}  // namespace fraudnet\n")
file(WRITE "${OUT}.tmp" "${CONTENT}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
